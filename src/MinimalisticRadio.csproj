<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 is part of every Windows 10/11, so the exe carries no runtime and stays tiny. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Minimalistic Radio</AssemblyName>
    <RootNamespace>MinimalisticRadio</RootNamespace>
    <ApplicationIcon>Assets\radio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Version>2.7.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Minimalistic Radio</Product>
    <Copyright></Copyright>
    <!-- The self-test and the README pictures (docs/BUILDING.md) are only in a build made with -p:SelfTest=true;
         the exe people download doesn't carry them. -->
    <SelfTest Condition="'$(SelfTest)' == ''">false</SelfTest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>
  <!-- Windows.winmd from whichever Windows 10/11 SDK is installed (only the metadata is used at build time). -->
  <PropertyGroup>
    <UnionMetadata>$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata</UnionMetadata>
    <WindowsWinmd Condition="'$(WindowsWinmd)' == '' And Exists('$(UnionMetadata)\10.0.22621.0\Windows.winmd')">$(UnionMetadata)\10.0.22621.0\Windows.winmd</WindowsWinmd>
    <WindowsWinmd Condition="'$(WindowsWinmd)' == '' And Exists('$(UnionMetadata)\10.0.26100.0\Windows.winmd')">$(UnionMetadata)\10.0.26100.0\Windows.winmd</WindowsWinmd>
    <WindowsWinmd Condition="'$(WindowsWinmd)' == '' And Exists('$(UnionMetadata)\10.0.22000.0\Windows.winmd')">$(UnionMetadata)\10.0.22000.0\Windows.winmd</WindowsWinmd>
    <WindowsWinmd Condition="'$(WindowsWinmd)' == '' And Exists('$(UnionMetadata)\10.0.20348.0\Windows.winmd')">$(UnionMetadata)\10.0.20348.0\Windows.winmd</WindowsWinmd>
    <WindowsWinmd Condition="'$(WindowsWinmd)' == '' And Exists('$(UnionMetadata)\10.0.19041.0\Windows.winmd')">$(UnionMetadata)\10.0.19041.0\Windows.winmd</WindowsWinmd>
  </PropertyGroup>
  <Target Name="RequireWindowsSdk" BeforeTargets="ResolveAssemblyReferences" Condition="'$(WindowsWinmd)' == ''">
    <Error Text="Windows 10/11 SDK not found (Windows.winmd). Install it with Visual Studio Installer or from https://developer.microsoft.com/windows/downloads/windows-sdk/" />
  </Target>
  <ItemGroup>

    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime" />
    <!-- WinRT (media playback, system media controls): metadata from the Windows SDK, runtime parts ship with Windows. -->
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows">
      <HintPath>$(WindowsWinmd)</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Page Remove="Theme\Theme.xaml" />
    <EmbeddedResource Include="../data/banned-stations.json" LogicalName="banned-stations.json" />
    <!-- The public key that updates are signed with (Updater.Signed); the release job checks its secret key against this file. -->
    <EmbeddedResource Include="../.github/update-signing.pub.pem" LogicalName="update-signing.pub.pem" />
    <EmbeddedResource Include="Theme\Theme.xaml" LogicalName="Theme.xaml" />
    <EmbeddedResource Include="Assets\Lucide_Icons_license.txt" LogicalName="Lucide_Icons_license.txt" />
  </ItemGroup>

  <!-- Translations: each Lang\<code>.po goes into the exe compressed (deflate) as the resource "Lang.<code>"; Lang.cs reads it. -->
  <ItemGroup>
    <Catalog Include="Lang\*.po" />
  </ItemGroup>
  <UsingTask TaskName="DeflateCatalogs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Folder Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Folder);
        foreach (var file in Files)
            using (var input = File.OpenRead(file.ItemSpec))
            using (var output = File.Create(Path.Combine(Folder, Path.GetFileNameWithoutExtension(file.ItemSpec) + ".deflate")))
            using (var packed = new DeflateStream(output, CompressionLevel.Optimal))
                input.CopyTo(packed);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="DeflateCatalogs" Inputs="@(Catalog)" Outputs="@(Catalog->'$(IntermediateOutputPath)Lang\%(Filename).deflate')">
    <DeflateCatalogs Files="@(Catalog)" Folder="$(IntermediateOutputPath)Lang" />
  </Target>
  <Target Name="EmbedCatalogs" DependsOnTargets="DeflateCatalogs" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <PackedCatalog Include="@(Catalog->'$(IntermediateOutputPath)Lang\%(Filename).deflate')" />
      <EmbeddedResource Include="@(PackedCatalog)" LogicalName="Lang.%(PackedCatalog.Filename)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <!-- The self-test checks that each catalog translates every L("…") in the code, so the test build carries the code. -->
  <ItemGroup Condition="'$(SelfTest)' == 'true'">
    <EmbeddedResource Include="@(Compile)" LogicalName="Source/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
