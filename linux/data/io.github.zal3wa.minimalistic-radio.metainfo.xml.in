<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.zal3wa.minimalistic-radio</id>
  <name>Minimalistic Radio</name>
  <summary>Internet radio that lives next to the clock</summary>
  <developer id="io.github.zal3wa">
    <name>zal3wa</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>A tiny open-source internet radio that lives in the system tray. Click the icon to pick a station and play it. The panel shows what is playing with its cover, the volume, a sleep timer and the song history. Stations can be searched in the radio-browser.info directory, added by hand, exported and imported. Media keys and the desktop's media controls work, and there is no telemetry.</p>
    <p>The radio only plays sound and never uses the microphone. If your software center still warns about the microphone, that is because Flatpak grants playing and recording sound as one permission.</p>
  </description>
  <launchable type="desktop-id">io.github.zal3wa.minimalistic-radio.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/zal3wa/minimalistic-radio/main/docs/screenshots/linux-stations-light.png</image>
      <caption>Stations</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/zal3wa/minimalistic-radio/main/docs/screenshots/linux-search-light.png</image>
      <caption>Search</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/zal3wa/minimalistic-radio/main/docs/screenshots/linux-history-light.png</image>
      <caption>Song history</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/zal3wa/minimalistic-radio/main/docs/screenshots/linux-settings-light.png</image>
      <caption>Settings</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/zal3wa/minimalistic-radio</url>
  <url type="bugtracker">https://github.com/zal3wa/minimalistic-radio/issues</url>
  <url type="vcs-browser">https://github.com/zal3wa/minimalistic-radio</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <releases>
    <release version="1.0.0" date="2026-11-15"/>
    <release version="1.0.0~beta.12" type="development" date="2026-11-25">
      <description translate="no">
        <p>The station search runs as you type:</p>
        <ul>
          <li>Results appear as soon as you stop typing for a moment. Enter and Search still search at once, and clearing the box brings the suggestions back.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0~beta.11" type="development" date="2026-11-19">
      <description translate="no">
        <p>Updating from the tray menu shows what happens:</p>
        <ul>
          <li>Update in the tray menu opens the radio's window first. If the update fails, the window says so. When it works, the new version opens with "Updated to version …".</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0~beta.10" type="development" date="2026-11-19">
      <description translate="no">
        <p>Clearer about the microphone:</p>
        <ul>
          <li>The Station item in the tray menu shows a music note instead of a microphone.</li>
          <li>The description explains why software centers say the radio can use the microphone: Flatpak's permission to play sound also allows recording. The radio never records.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0~beta.9" type="development" date="2026-11-16">
      <description translate="no">
        <p>Sharing and statistics:</p>
        <ul>
          <li>A station from a shared link can be added without stopping what you are listening to: uncheck "Play automatically" under Add. The radio remembers the choice.</li>
          <li>A link to a station that is already on your list plays it only when "Play automatically" is checked; otherwise the list shows the station.</li>
          <li>"Clear statistics…" is now in the ⋯ menu of the Statistics page, and it says that your song history stays.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0~beta.8" type="development" date="2026-11-16">
      <description translate="no">
        <p>Safer with pictures and texts from the internet:</p>
        <ul>
          <li>Pictures larger than 4096 pixels on a side are not opened, so a logo or a cover can't use up the memory.</li>
          <li>Logos and covers are never loaded from your home network.</li>
          <li>A station that changes its song title many times a second no longer slows the radio down.</li>
          <li>Downloads give up after 30 seconds.</li>
          <li>Station names and song titles can't turn their text around with hidden direction marks.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
