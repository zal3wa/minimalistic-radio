<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.zal3wa.MinimalisticRadio</id>
  <name>Minimalistic Radio</name>
  <summary>Internet radio that lives next to the clock</summary>
  <developer id="io.github.zal3wa">
    <name>zal3wa</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>A tiny open-source internet radio that lives in the system tray. Click the icon to pick a station and play it. The panel shows what is playing with its cover, the volume, a sleep timer and the song history. Stations can be searched in the radio-browser.info directory, added by hand, exported and imported. Media keys and the desktop's media controls work, and there is no telemetry.</p>
  </description>
  <launchable type="desktop-id">io.github.zal3wa.MinimalisticRadio.desktop</launchable>
  <url type="homepage">https://github.com/zal3wa/minimalistic-radio</url>
  <url type="bugtracker">https://github.com/zal3wa/minimalistic-radio/issues</url>
  <url type="vcs-browser">https://github.com/zal3wa/minimalistic-radio</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <releases>
    <release version="1.0.0" date="2026-11-15"/>
  </releases>
</component>
