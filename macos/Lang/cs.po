# Czech translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: cs\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "Zkopírováno do schránky"

msgid "Import…"
msgstr "Importovat…"

msgid "Open at login"
msgstr "Otevírat při přihlášení"

msgid "Quit"
msgstr "Ukončit"

msgid "Add a station first."
msgstr "Nejdřív přidejte stanici."

msgid "Now playing"
msgstr "Právě hraje"

msgid "Copied"
msgstr "Zkopírováno"

msgid "Copy title"
msgstr "Kopírovat název"

msgid "Add a station"
msgstr "Přidat stanici"

msgid "Ready to play"
msgstr "Připraveno k přehrávání"

msgid "Connecting to the station…"
msgstr "Připojování ke stanici…"

msgid "The station doesn't send song titles"
msgstr "Stanice neposílá názvy skladeb"

msgid "Stopped"
msgstr "Zastaveno"

msgid "Unmute"
msgstr "Zrušit ztlumení"

msgid "Mute"
msgstr "Ztlumit"

msgid "Volume"
msgstr "Hlasitost"

msgid "Sleep timer"
msgstr "Časovač vypnutí"

msgid "Stop"
msgstr "Zastavit"

msgid "Play"
msgstr "Přehrát"

msgid "Station"
msgstr "Stanice"

msgid "Search the radio-browser.info directory"
msgstr "Hledat v katalogu radio-browser.info"

msgid "Back"
msgstr "Zpět"

msgid "Song history"
msgstr "Historie skladeb"

msgid "Settings"
msgstr "Nastavení"

msgid "Hide the panel (the radio keeps playing)"
msgstr "Skrýt panel (rádio hraje dál)"

msgid "Stations"
msgstr "Stanice"

msgid "Add by address"
msgstr "Přidat podle adresy"

msgid "Edit"
msgstr "Upravit"

msgid "Station name"
msgstr "Název stanice"

msgid "Stream address (HTTP or HTTPS)"
msgstr "Adresa streamu (HTTP nebo HTTPS)"

msgid "Logo address (optional)"
msgstr "Adresa loga (nepovinné)"

msgid "Cancel"
msgstr "Zrušit"

msgid "Save"
msgstr "Uložit"

msgid "This address is already on the list."
msgstr "Tato adresa už je v seznamu."

msgid "Enter a name and a valid stream address. The logo is optional."
msgstr "Zadejte název a platnou adresu streamu. Logo je nepovinné."

msgid "Remove"
msgstr "Odebrat"

msgid "Station options"
msgstr "Možnosti stanice"

msgid "This station uses a format that can't be played."
msgstr "Tato stanice vysílá ve formátu, který nelze přehrát."

msgid "The connection to the station was lost."
msgstr "Spojení se stanicí bylo přerušeno."

msgid "The station's server refused access ({code})."
msgstr "Server stanice odepřel přístup ({code})."

msgid "The station's server refused access."
msgstr "Server stanice odepřel přístup."

msgid "The station's server returned error {code}."
msgstr "Server stanice vrátil chybu {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "Ke stanici se nepodařilo připojit. Zkontrolujte internet."

msgid "Download update"
msgstr "Stáhnout aktualizaci"

msgid "Update"
msgstr "Aktualizovat"

msgid "You have the latest version."
msgstr "Máte nejnovější verzi."

msgid "Couldn't check for updates."
msgstr "Aktualizace se nepodařilo zkontrolovat."

msgid "macOS may ask once for permission to update the radio."
msgstr "macOS se může jednou zeptat na povolení aktualizovat rádio."

msgid "Drag Minimalistic Radio to Applications to finish the update."
msgstr "Dokončete aktualizaci přetažením Minimalistic Radio do Aplikací."

msgid "Couldn't save the station list."
msgstr "Seznam stanic se nepodařilo uložit."

msgid "The broadcast has ended"
msgstr "Vysílání skončilo"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Spojení ztraceno. Znovu za {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Zastaveno časovačem vypnutí"

msgid "This isn't a Minimalistic Radio station list."
msgstr "Toto není seznam stanic Minimalistic Radio."

msgid "Up 5%"
msgstr "Zvýšit o 5%"

msgid "Down 5%"
msgstr "Snížit o 5%"

msgid "Stops at {0}"
msgstr "Vypne se v {0}"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Vypnuto"

msgid "Minimalistic Radio isn't ready yet. Try again."
msgstr "Minimalistic Radio ještě není připravené. Zkuste to znovu."

msgid "Plays the last station."
msgstr "Pustí poslední stanici."

msgid "Play Station"
msgstr "Pustit stanici"

msgid "Plays one of your stations."
msgstr "Pustí jednu z vašich stanic."

msgid "Stops the radio."
msgstr "Zastaví rádio."

msgid "Next Station"
msgstr "Další stanice"

msgid "Switches to the next station on your list."
msgstr "Přepne na další stanici ve vašem seznamu."

msgid "Previous Station"
msgstr "Předchozí stanice"

msgid "Switches to the previous station on your list."
msgstr "Přepne na předchozí stanici ve vašem seznamu."

msgid "Set Sleep Timer"
msgstr "Nastavit časovač vypnutí"

msgid "Stops the radio after the minutes you choose. 0 turns the timer off."
msgstr "Zastaví rádio po zvoleném počtu minut. 0 časovač vypne."

msgid "Minutes"
msgstr "Minuty"

msgid "Set Volume"
msgstr "Nastavit hlasitost"

msgid "Sets the radio's volume, from 0 to 100."
msgstr "Nastaví hlasitost rádia od 0 do 100."

msgid "Play ${station} in ${applicationName}"
msgstr "Pusť ${station} v ${applicationName}"

msgid "Play ${applicationName}"
msgstr "Pusť ${applicationName}"

msgid "Stop ${applicationName}"
msgstr "Zastav ${applicationName}"

msgid "Next station in ${applicationName}"
msgstr "Další stanice v ${applicationName}"

msgid "Previous station in ${applicationName}"
msgstr "Předchozí stanice v ${applicationName}"
