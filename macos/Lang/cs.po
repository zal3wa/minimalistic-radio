msgid "Couldn't download the update. The radio will try again later."
msgstr "Aktualizaci se nepodařilo stáhnout. Rádio to zkusí později znovu."

msgid "macOS didn't let the radio replace itself. The update opens as a disk image instead."
msgstr "macOS rádiu nedovolil, aby se samo nahradilo. Aktualizace se místo toho otevře jako obraz disku."

msgid "The update couldn't be unpacked. It opens as a disk image instead."
msgstr "Aktualizaci se nepodařilo rozbalit. Místo toho se otevře jako obraz disku."

msgid "The update isn't signed like this radio, so it wasn't installed. Its page opens instead."
msgstr "Aktualizace není podepsaná stejně jako toto rádio, proto nebyla nainstalována. Místo toho se otevře její stránka."

msgid "The update file doesn't match its version, so it wasn't installed. Its page opens instead."
msgstr "Soubor aktualizace neodpovídá její verzi, proto nebyl nainstalován. Místo toho se otevře její stránka."

msgid "Minimalistic Radio isn't ready yet. Try again."
