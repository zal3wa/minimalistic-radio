# Portuguese translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: pt\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "Copiado para a área de transferência"

msgid "Import…"
msgstr "Importar…"

msgid "Open at login"
msgstr "Abrir ao iniciar sessão"

msgid "Quit"
msgstr "Sair"

msgid "This station uses a format that can't be played."
msgstr "Esta estação usa um formato que não pode ser reproduzido."

msgid "The connection to the station was lost."
msgstr "A ligação à estação foi interrompida."

msgid "The station's server refused access ({code})."
msgstr "O servidor da estação recusou o acesso ({code})."

