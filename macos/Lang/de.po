# German translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "In die Zwischenablage kopiert"

msgid "Import…"
msgstr "Importieren…"

msgid "Open at login"
msgstr "Beim Anmelden öffnen"

msgid "Quit"
msgstr "Beenden"

msgid "Add a station first."
msgstr "Füge zuerst einen Sender hinzu."

msgid "This station uses a format that can't be played."
msgstr "Dieser Sender nutzt ein Format, das nicht abgespielt werden kann."

msgid "The connection to the station was lost."
msgstr "Die Verbindung zum Sender wurde unterbrochen."

msgid "The station's server refused access ({code})."
msgstr "Der Server des Senders hat den Zugriff verweigert ({code})."

msgid "The station's server refused access."
msgstr "Der Server des Senders hat den Zugriff verweigert."

msgid "The station's server returned error {code}."
msgstr "Der Server des Senders meldet den Fehler {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "Keine Verbindung zum Sender. Bitte die Internetverbindung prüfen."

msgid "Download update"
msgstr "Update laden"

msgid "Update"
msgstr "Aktualisieren"

msgid "You have the latest version."
msgstr "Die neueste Version ist installiert."

msgid "Couldn't check for updates."
msgstr "Suche nach Updates fehlgeschlagen."

msgid "macOS may ask once for permission to update the radio."
msgstr "macOS fragt eventuell einmal um Erlaubnis, das Radio zu aktualisieren."

msgid "Drag Minimalistic Radio to Applications to finish the update."
msgstr "Zieh Minimalistic Radio in „Programme“, um das Update abzuschließen."

msgid "Couldn't save the station list."
msgstr "Die Senderliste konnte nicht gespeichert werden."

msgid "The broadcast has ended"
msgstr "Die Übertragung ist beendet"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Verbindung verloren. Neuer Versuch in {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Vom Sleep-Timer gestoppt"

msgid "This isn't a Minimalistic Radio station list."
msgstr "Das ist keine Senderliste von Minimalistic Radio."

msgid "Stop"
msgstr "Stopp"

msgid "Play"
msgstr "Wiedergabe"

msgid "Station"
msgstr "Sender"

msgid "Up 5%"
msgstr "5% lauter"

msgid "Down 5%"
msgstr "5% leiser"

msgid "Mute"
msgstr "Stummschalten"

msgid "Volume"
msgstr "Lautstärke"

msgid "Stops at {0}"
msgstr "Stoppt um {0}"

msgid "Sleep timer"
msgstr "Sleep-Timer"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Aus"

msgid "Settings"
msgstr "Einstellungen"

msgid "Minimalistic Radio isn't ready yet. Try again."
msgstr "Minimalistic Radio ist noch nicht bereit. Versuch es noch einmal."

msgid "Plays the last station."
msgstr "Spielt den zuletzt gehörten Sender."

msgid "Play Station"
msgstr "Sender abspielen"

msgid "Plays one of your stations."
msgstr "Spielt einen deiner Sender."

msgid "Stops the radio."
msgstr "Stoppt das Radio."

msgid "Next Station"
msgstr "Nächster Sender"

msgid "Switches to the next station on your list."
msgstr "Wechselt zum nächsten Sender in deiner Liste."

msgid "Previous Station"
msgstr "Vorheriger Sender"

msgid "Switches to the previous station on your list."
msgstr "Wechselt zum vorherigen Sender in deiner Liste."

msgid "Set Sleep Timer"
msgstr "Sleep-Timer stellen"

msgid "Stops the radio after the minutes you choose. 0 turns the timer off."
msgstr "Stoppt das Radio nach den gewählten Minuten. 0 schaltet den Timer aus."

msgid "Minutes"
msgstr "Minuten"

msgid "Set Volume"
msgstr "Lautstärke einstellen"

msgid "Sets the radio's volume, from 0 to 100."
msgstr "Stellt die Lautstärke des Radios ein, von 0 bis 100."

msgid "Play ${station} in ${applicationName}"
msgstr "Spiel ${station} in ${applicationName}"

msgid "Play ${applicationName}"
msgstr "Spiel ${applicationName}"

msgid "Stop ${applicationName}"
msgstr "Stopp ${applicationName}"

msgid "Next station in ${applicationName}"
msgstr "Nächster Sender in ${applicationName}"

msgid "Previous station in ${applicationName}"
msgstr "Vorheriger Sender in ${applicationName}"
