# Italian translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Quit"
msgstr "Esci"

msgid "This station uses a format that can't be played."
msgstr "Questa stazione usa un formato che non può essere riprodotto."

msgid "The connection to the station was lost."
msgstr "La connessione alla stazione si è interrotta."

msgid "The station's server refused access ({code})."
msgstr "Il server della stazione ha negato l'accesso ({code})."

msgid "The station's server refused access."
msgstr "Il server della stazione ha negato l'accesso."

msgid "The station's server returned error {code}."
msgstr "Il server della stazione ha restituito l'errore {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "Impossibile connettersi alla stazione. Controlla la connessione a Internet."

msgid "Couldn't save the station list."
msgstr "Impossibile salvare l'elenco delle stazioni."

msgid "The broadcast has ended"
msgstr "La trasmissione è terminata"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Connessione persa. Nuovo tentativo tra {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Spento dal timer"

msgid "This isn't a Minimalistic Radio station list."
msgstr "Questo non è un elenco di stazioni di Minimalistic Radio."

msgid "Stop"
msgstr "Interrompi"

msgid "Play"
msgstr "Riproduci"

msgid "Station"
msgstr "Stazione"

msgid "Up 5%"
msgstr "Alza del 5%"

msgid "Down 5%"
msgstr "Abbassa del 5%"

msgid "Mute"
msgstr "Disattiva audio"

msgid "Volume"
msgstr "Volume"

msgid "Stops at {0}"
msgstr "Si spegne alle {0}"

msgid "Sleep timer"
msgstr "Timer di spegnimento"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Disattivato"

msgid "Settings"
msgstr "Impostazioni"
