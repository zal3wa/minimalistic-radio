# Spanish translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "Copiado al portapapeles"

msgid "Import…"
msgstr "Importar…"

msgid "Open at login"
msgstr "Abrir al iniciar sesión"

msgid "Quit"
msgstr "Salir"

msgid "Add a station first."
msgstr "Primero añade una emisora."

msgid "This station uses a format that can't be played."
msgstr "Esta emisora usa un formato que no se puede reproducir."

msgid "The connection to the station was lost."
msgstr "Se perdió la conexión con la emisora."

msgid "The station's server refused access ({code})."
msgstr "El servidor de la emisora denegó el acceso ({code})."

msgid "The station's server refused access."
msgstr "El servidor de la emisora denegó el acceso."

msgid "The station's server returned error {code}."
msgstr "El servidor de la emisora devolvió el error {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "No se pudo conectar con la emisora. Comprueba tu conexión a internet."

msgid "Download update"
msgstr "Descargar actualización"

msgid "Update"
msgstr "Actualizar"

msgid "You have the latest version."
msgstr "Tienes la versión más reciente."

msgid "Couldn't check for updates."
msgstr "No se pudieron buscar actualizaciones."

msgid "macOS may ask once for permission to update the radio."
msgstr "Puede que macOS pida permiso una vez para actualizar la radio."

msgid "Drag Minimalistic Radio to Applications to finish the update."
msgstr "Arrastra Minimalistic Radio a Aplicaciones para terminar la actualización."

msgid "Couldn't save the station list."
msgstr "No se pudo guardar la lista de emisoras."

msgid "The broadcast has ended"
msgstr "La emisión ha terminado"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Se perdió la conexión. Reintentando en {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Detenido por el temporizador"

msgid "This isn't a Minimalistic Radio station list."
msgstr "No es una lista de emisoras de Minimalistic Radio."

msgid "Stop"
msgstr "Detener"

msgid "Play"
msgstr "Reproducir"

msgid "Station"
msgstr "Emisora"

msgid "Up 5%"
msgstr "Subir un 5%"

msgid "Down 5%"
msgstr "Bajar un 5%"

msgid "Mute"
msgstr "Silenciar"

msgid "Volume"
msgstr "Volumen"

msgid "Stops at {0}"
msgstr "Se apaga a las {0}"

msgid "Sleep timer"
msgstr "Temporizador de apagado"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Desactivado"

msgid "Settings"
msgstr "Configuración"

msgid "Minimalistic Radio isn't ready yet. Try again."
msgstr "Minimalistic Radio aún no está listo. Inténtalo de nuevo."

msgid "Plays the last station."
msgstr "Reproduce la última emisora."

msgid "Play Station"
msgstr "Reproducir emisora"

msgid "Plays one of your stations."
msgstr "Reproduce una de tus emisoras."

msgid "Stops the radio."
msgstr "Detiene la radio."

msgid "Next Station"
msgstr "Emisora siguiente"

msgid "Switches to the next station on your list."
msgstr "Cambia a la siguiente emisora de tu lista."

msgid "Previous Station"
msgstr "Emisora anterior"

msgid "Switches to the previous station on your list."
msgstr "Cambia a la emisora anterior de tu lista."

msgid "Set Sleep Timer"
msgstr "Programar el temporizador de apagado"

msgid "Stops the radio after the minutes you choose. 0 turns the timer off."
msgstr "Detiene la radio tras los minutos que elijas. 0 desactiva el temporizador."

msgid "Minutes"
msgstr "Minutos"

msgid "Set Volume"
msgstr "Ajustar el volumen"

msgid "Sets the radio's volume, from 0 to 100."
msgstr "Ajusta el volumen de la radio, de 0 a 100."

msgid "Play ${station} in ${applicationName}"
msgstr "Pon ${station} en ${applicationName}"

msgid "Play ${applicationName}"
msgstr "Pon ${applicationName}"

msgid "Stop ${applicationName}"
msgstr "Detén ${applicationName}"

msgid "Next station in ${applicationName}"
msgstr "Siguiente emisora en ${applicationName}"

msgid "Previous station in ${applicationName}"
msgstr "Emisora anterior en ${applicationName}"
