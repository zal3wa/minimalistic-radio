# French translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "Copié dans le Presse-papiers"

msgid "Import…"
msgstr "Importer…"

msgid "Open at login"
msgstr "Ouvrir à l'ouverture de session"

msgid "Quit"
msgstr "Quitter"

msgid "This station uses a format that can't be played."
msgstr "Cette station utilise un format qui ne peut pas être lu."

msgid "The connection to the station was lost."
msgstr "La connexion à la station a été perdue."

msgid "The station's server refused access ({code})."
msgstr "Le serveur de la station a refusé l'accès ({code})."

msgid "The station's server refused access."
msgstr "Le serveur de la station a refusé l'accès."

msgid "The station's server returned error {code}."
msgstr "Le serveur de la station a renvoyé l'erreur {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "Impossible de se connecter à la station. Vérifiez votre connexion Internet."

msgid "Download update"
msgstr "Télécharger la mise à jour"

msgid "Update"
msgstr "Mettre à jour"

msgid "You have the latest version."
msgstr "Vous avez la dernière version."

msgid "Couldn't check for updates."
msgstr "Impossible de rechercher les mises à jour."

msgid "macOS may ask once for permission to update the radio."
msgstr "macOS peut demander une fois l'autorisation de mettre à jour la radio."

msgid "Drag Minimalistic Radio to Applications to finish the update."
msgstr "Faites glisser Minimalistic Radio dans Applications pour terminer la mise à jour."

msgid "Couldn't save the station list."
msgstr "Impossible d'enregistrer la liste des stations."

msgid "The broadcast has ended"
msgstr "La diffusion est terminée"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Connexion perdue. Nouvel essai dans {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Arrêté par le minuteur"

msgid "This isn't a Minimalistic Radio station list."
msgstr "Ce n'est pas une liste de stations Minimalistic Radio."

msgid "Stop"
msgstr "Arrêter"

msgid "Play"
msgstr "Lire"

msgid "Station"
msgstr "Station"

msgid "Up 5%"
msgstr "Augmenter de 5%"

msgid "Down 5%"
msgstr "Baisser de 5%"

msgid "Mute"
msgstr "Couper le son"

msgid "Volume"
msgstr "Volume"

msgid "Stops at {0}"
msgstr "S'arrête à {0}"

msgid "Sleep timer"
msgstr "Minuteur d'arrêt"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Désactivé"

msgid "Settings"
msgstr "Paramètres"
