msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Quit"
msgstr "Quitter"

msgid "This station uses a format that can't be played."
msgstr "Cette station utilise un format qui ne peut pas être lu."

msgid "The connection to the station was lost."
msgstr "La connexion à la station a été perdue."

msgid "The station's server refused access ({code})."
msgstr "Le serveur de la station a refusé l'accès ({code})."

