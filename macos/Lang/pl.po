# Polish translation of Minimalistic Radio for macOS.
# The English text is the msgid. Corrections by native speakers are welcome.
msgid ""
msgstr ""
"Language: pl\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Copied to clipboard"
msgstr "Skopiowano do schowka"

msgid "Import…"
msgstr "Importuj…"

msgid "Open at login"
msgstr "Otwieraj przy logowaniu"

msgid "Quit"
msgstr "Zakończ"

msgid "This station uses a format that can't be played."
msgstr "Ta stacja nadaje w formacie, którego nie da się odtworzyć."

msgid "The connection to the station was lost."
msgstr "Połączenie ze stacją zostało przerwane."

msgid "The station's server refused access ({code})."
msgstr "Serwer stacji odmówił dostępu ({code})."

msgid "The station's server refused access."
msgstr "Serwer stacji odmówił dostępu."

msgid "The station's server returned error {code}."
msgstr "Serwer stacji zwrócił błąd {code}."

msgid "Couldn't connect to the station. Check your internet connection."
msgstr "Nie udało się połączyć ze stacją. Sprawdź internet."

msgid "Couldn't save the station list."
msgstr "Nie udało się zapisać listy stacji."

msgid "The broadcast has ended"
msgstr "Transmisja zakończyła się"

msgid "Connection lost. Retrying in {0} s…"
msgstr "Brak połączenia. Ponawiam za {0} s…"

msgid "Stopped by the sleep timer"
msgstr "Wyłączono wyłącznikiem czasowym"

msgid "This isn't a Minimalistic Radio station list."
msgstr "To nie jest lista stacji Minimalistic Radio."

msgid "Stop"
msgstr "Zatrzymaj"

msgid "Play"
msgstr "Odtwórz"

msgid "Station"
msgstr "Stacja"

msgid "Up 5%"
msgstr "Zwiększ o 5%"

msgid "Down 5%"
msgstr "Zmniejsz o 5%"

msgid "Mute"
msgstr "Wycisz"

msgid "Volume"
msgstr "Głośność"

msgid "Stops at {0}"
msgstr "Wyłączy się o {0}"

msgid "Sleep timer"
msgstr "Wyłącznik czasowy"

msgid "{0} min"
msgstr "{0} min"

msgid "Off"
msgstr "Wył."

msgid "Settings"
msgstr "Ustawienia"
